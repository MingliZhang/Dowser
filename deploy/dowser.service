# systemd unit for running Dowser 24/7 on a Linux home server.
#
# PREFER THE INSTALLER — it fills all of this in from your actual layout:
#
#   sudo deploy/install-service.sh
#
# What follows is a hand-editable template. Copying it unchanged WILL FAIL:
# the user and paths below are placeholders, not defaults. Replace every
# `dowser` user and every `/opt/dowser` path with your own.
#
#   sudo cp deploy/dowser.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dowser
#   journalctl -u dowser -f          # follow the logs

[Unit]
Description=Dowser — finds and downloads video streams from any page
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# REPLACE: this user must already exist, or systemd fails with status=217/USER.
# Running as an existing login user (or root) is fine on a home server.
User=dowser
Group=dowser

WorkingDirectory=/opt/dowser
# HOST defaults to 0.0.0.0 (all interfaces). Put HOST=127.0.0.1 in the .env
# below if you would rather reach it only through a reverse proxy.
EnvironmentFile=-/opt/dowser/.env
ExecStart=/opt/dowser/.venv/bin/python -m app.main

# Restart on any exit, including a crash mid-download. Queued jobs are
# persisted, and interrupted ones re-arm themselves when auto-retry is on.
Restart=always
RestartSec=5

# SIGINT lets uvicorn shut down cleanly so in-flight ffmpeg children are killed
# and partial files are removed rather than left behind.
KillSignal=SIGINT
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dowser

# No core dumps. If the OOM killer takes this service, systemd-coredump would
# otherwise write a snapshot of a multi-gigabyte process to disk — repeatedly,
# on the very machine that just ran out of room.
LimitCORE=0

# Light hardening. If your download folder lives outside WorkingDirectory, add
# it to ReadWritePaths or the service will not be able to write there. The `-`
# prefix stops systemd refusing to start over a path that does not exist yet.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
ReadWritePaths=-/opt/dowser -/srv/media/downloads

[Install]
WantedBy=multi-user.target
