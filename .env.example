# Copy to .env and adjust. Every value below is optional.
#
# NOTE: anything marked [UI] is only a starting default. Once you change it in
# the Settings panel the new value is saved to settings.json and wins over this
# file, so editing it here afterwards has no effect. Delete settings.json (or
# press "Reset to defaults") to go back to these values.

# --- server ---
HOST=127.0.0.1
PORT=8477

# --- storage ---
# Finished videos land here, named after the page title.
DOWNLOAD_DIR=./downloads
# Partial downloads live here and are moved on completion. Defaults to
# a .incomplete folder inside DOWNLOAD_DIR — only set this if you want them
# elsewhere (keep it on the same filesystem, or the final move has to copy).
# TEMP_DIR=/fast-disk/incomplete
STATE_FILE=./state.json
SETTINGS_FILE=./settings.json

# --- queue ---
MAX_CONCURRENT_DOWNLOADS=2          # [UI] Parallel downloads

# --- stall detection and retries ---
# A running download that makes no progress for this many seconds is treated as
# stuck, killed, and retried. 0 disables stall detection entirely.
STALL_TIMEOUT=90                    # [UI] Stall timeout
AUTO_RETRY=true                     # [UI] Retry automatically
RETRY_DELAY=30                      # [UI] Wait before retrying
MAX_RETRIES=3                       # [UI] Retry attempts

# --- detection ---
# Load each page in a headless browser and watch its network traffic. Unlike the
# others this one is not exposed in the UI — it turns the whole feature off.
ENABLE_SNIFFER=true
SNIFF_TIMEOUT=25                    # [UI] Page scan time
SNIFF_HEADLESS=true                 # [UI] Headless browser
SNIFF_AUTOPLAY=true                 # [UI] Click play & consent buttons

# --- authenticated sites ---
# Reuse a logged-in session. Either point at a cookies.txt file...
# COOKIES_FILE=./cookies.txt
# ...or pull them straight from a local browser (chrome, firefox, safari, edge, brave).
# COOKIES_FROM_BROWSER=chrome

# --- binaries ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp

# USER_AGENT=Mozilla/5.0 ...
