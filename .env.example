# Copy to .env and adjust. Every value below is optional.

# --- server ---
HOST=127.0.0.1
PORT=8081

# --- storage ---
# Finished videos land here, named after the page title.
DOWNLOAD_DIR=./downloads
# Partial downloads live here and are moved on completion. Defaults to
# a .incomplete folder inside DOWNLOAD_DIR — only set this if you want them
# elsewhere (keep it on the same filesystem, or the final move has to copy).
# TEMP_DIR=/fast-disk/incomplete
STATE_FILE=./state.json

# --- queue ---
MAX_CONCURRENT_DOWNLOADS=2

# --- detection ---
# Load each page in a headless browser and watch its network traffic.
ENABLE_SNIFFER=true
# Seconds to let a page run before we stop collecting requests. Raise this for
# slow players; lower it if you are scanning a lot of pages.
SNIFF_TIMEOUT=25
# Set to false to watch the browser work — useful for pages behind a bot check.
SNIFF_HEADLESS=true
# Click play/consent buttons to coax a player into loading its stream.
SNIFF_AUTOPLAY=true

# --- authenticated sites ---
# Reuse a logged-in session. Either point at a cookies.txt file...
# COOKIES_FILE=./cookies.txt
# ...or pull them straight from a local browser (chrome, firefox, safari, edge, brave).
# COOKIES_FROM_BROWSER=chrome

# --- binaries ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp

# USER_AGENT=Mozilla/5.0 ...
